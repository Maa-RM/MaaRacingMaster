<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>MaaRacingMaster.Shell</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- exe 图标（资源管理器/任务栏默认图标） -->
    <ApplicationIcon>..\..\assets\icon.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260710003" />
    <!-- 应用升级 SDK（版本固定，与发布打包 CLI 同源同版）：升级运行时只接启动钩子（最小注入），下载/提交由宿主更新协调器驱动 -->
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <!-- 壳专用工具（合同探针等）有自己的入口与工程，不进壳本体编译 -->
  <ItemGroup>
    <Compile Remove="tools\**" />
  </ItemGroup>

</Project>
