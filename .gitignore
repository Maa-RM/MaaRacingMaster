# Python
__pycache__/
*.pyc

# setuptools-scm 自动生成（版本号从 Git Tag 推导）
maaracing_master/_version.py
*.pyo
*.egg-info/
env/
venv/

# 数据集（大文件）
runs/
tools/*.pt

# 标注工作区与训练索引（本机数据，不进发布包；打包侧另有 robocopy 排除）
/maaracing_master/plugins/_archive/speedrush/data/
/maaracing_master/plugins/infinite_drive/data/

# 日志
logs/
*.log
debug.txt
/debug/

# 运行时数据（鉴宝结构化落盘数据库 data/treasure/treasure.db）
/data/

# IDE 交换文件（IDE 目录本身由上面「本机面」白名单覆盖）
*.swp

# =============================================================================
# 本机面（规则）：顶层点目录 / 点文件默认不入库，只放行明确上云的条目。
# 各 coding agent 的 harness 目录（.trae/ .zcode/ .qoder/ .workbuddy-ai/
# .screenshots/ .meituan-catpaw/ .zwork/ .mimosa/ .venv/ .pytest_cache/ …）由此
# 自动覆盖——装一个新工具不再需要回来补枚举；漏一个枚举的代价是 git add -A
# 把本机路径带上云，代价远大于「新增合法点文件时要记得补一行 !」。
# 注意：放行必须写在目录本身（!/.github/），父目录被忽略时 git 不会进目录内判断。
# 嵌套的点目录不在本段覆盖内（本段只锚定顶层）。
# =============================================================================
/.*
!/.gitattributes
!/.gitignore
!/.zcodeignore
!/.github/

# AGENTS.local.md 是项目专属本机个性化规则（不上云，经 AGENTS.md 开头指针加载），
# AGENTS.md 是项目守则（上云），分工见各自文件头
AGENTS.local.md
# 隐私扫描本地词表（check_repo_hygiene R7 的补充正则；只留本机，不上云）
tools/repo_privacy_terms.local.txt
# 嵌套的本机状态目录（上面白名单只锚顶层，插件与子系统里落盘的按需显式列出；
# .mimosa 账本会落在 apps/* 与 _archive 插件目录，现已存在三处）
.mimosa/

# AI 生成的 plan 文档（过程产物，不入库）
docs/plan/

# 本机 harness 配置说明（含本机路径，仅本地参考）
docs/trae-dsh-config-share.md

# 归档（被 sidecar + WinUI3 取代的旧 GUI、历史 spike）
archive/

# 插件模型权重随包分发入库（各权重许可与来源声明见对应插件 resources/models/
# README 与 THIRD_PARTY_LICENSES.md「模型权重」节）

# WinUI 3 / .NET 构建产物（apps/MaaRacingMaster.Shell）
apps/MaaRacingMaster.Shell/bin/
apps/MaaRacingMaster.Shell/obj/
# 壳专用工具（合同探针等）自己的构建产物
apps/MaaRacingMaster.Shell/tools/**/bin/
apps/MaaRacingMaster.Shell/tools/**/obj/

# 本地构建缓存/实验/验证产物目录（整体忽略：zip/dll/runtime-cache/publish-cache/C1 基准/7z 下载缓存等均不入库；
# 唯一入库的 7za.exe 已在 scripts/release/tools/ 单独跟踪）
build/

# 发布打包产物（体积大，不入库；本地 staging/zip/sha256 放这里）
build/release/
# 探索/验证用临时运行时（spike 的完整 python runtime 数百 MB，不入库）
build/spike/
# 体积优化实验产物与全量 runtime 临时目录（exp1..expN / runtime-full，可由 assemble 重建，不入库）
build/exp*/
build/runtime-full/

# 本地复用缓存（已验证 runtime 依赖 + 已编译 GUI，跳过重复下载/编译）
build/runtime-cache/
build/publish-cache/

# PoC / 本地打包测试产物（native Launcher 编译输出、临时测试布局、组装测试目录）
build/poc/
build/poc-app/
build/PoC */
build/assemble-test/
build/zip-e2e/

# assemble.ps1 本地打包产物（默认输出到 scripts/release；CI 输出到 build/release 已忽略）
scripts/release/MaaRacingMaster-*/
scripts/release/MaaRacingMaster-*.zip
scripts/release/MaaRacingMaster-*.zip.sha256

# 系统
Thumbs.db
.DS_Store

# 本机启动快捷方式（指向机器相关构建产物路径，仅本地使用，不同步）
*.lnk

# cursor_refactor 光标训练/趋近工具：只入库脚本，忽略采集帧与模型产物（体积大）
cursor_refactor/captures/
cursor_refactor/models/
cursor_refactor/__pycache__/

# pipeline 工具的本机二进制（mpelb 等；不入库）
tools/pipeline/dev/

# 实验区的待试权重：来源与许可未声明、体积大，一律不入库（实验 README 注明取法）。
# 插件正式分发的权重不在此列——它们在 plugins/*/resources/models/ 随包入库。
tools/experiments/**/weights/
tools/experiments/**/upstream/
# 离线教师权重（HuggingFace 公开模型，体积 100MB+，取法与许可记在实验 README）
tools/experiments/**/teachers/

# 探针输出目录（命名约定 *_out/）：一次性报告的落点，读数归实验 README，文件本身可重跑。
# 上规则的前提是「结论已进 README」——报告里还藏着没写下来的结论时，先补 README 再忽略。
tools/experiments/**/*_out/

# 实验区内 .NET/C# 构建产物（编译输出与 NuGet 还原缓存，可由源码重建，不入库；
# 工具源码真源仍随目录入库，清理走回收站）
tools/experiments/**/bin/
tools/experiments/**/obj/

# 随插件归档的实验目录（plugins/_archive/<插件>/experiments/）沿用实验区同款忽略口径
maaracing_master/plugins/_archive/*/experiments/**/weights/
maaracing_master/plugins/_archive/*/experiments/**/upstream/
maaracing_master/plugins/_archive/*/experiments/**/teachers/
maaracing_master/plugins/_archive/*/experiments/**/*_out/
maaracing_master/plugins/_archive/*/experiments/**/bin/
maaracing_master/plugins/_archive/*/experiments/**/obj/
